{
  "info": {
    "name": "Backend Assignment CRUD APIs",
    "description": "Postman Collection to test all CRUD APIs for the Node.js, Express & MongoDB backend assignment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "PASTE_USER_ID_HERE",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Server Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": [""]
        },
        "description": "Verify that the Express server is up and running."
      }
    },
    {
      "name": "2. Create User (POST)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Arman Gupta\",\n  \"email\": \"arman@example.com\",\n  \"age\": 22,\n  \"role\": \"user\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users"]
        },
        "description": "Create a new user document in MongoDB. Copy the returned _id to use in subsequent requests."
      }
    },
    {
      "name": "3. Get All Users (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users"]
        },
        "description": "Fetch all user records from the database."
      }
    },
    {
      "name": "4. Get User by ID (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users/{{userId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "{{userId}}"]
        },
        "description": "Fetch a specific user document using their MongoDB ObjectId."
      }
    },
    {
      "name": "5. Update User (PUT)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Arman Gupta (Updated)\",\n  \"age\": 23\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/users/{{userId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "{{userId}}"]
        },
        "description": "Update fields of an existing user document by ID."
      }
    },
    {
      "name": "6. Delete User (DELETE)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users/{{userId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "{{userId}}"]
        },
        "description": "Delete a user document by ID from the database."
      }
    }
  ]
}
