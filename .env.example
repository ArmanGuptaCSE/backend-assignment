PORT=5000
# Replace with your MongoDB connection string from MongoDB Atlas or local MongoDB:
# Example Atlas format: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/myDatabase?retryWrites=true&w=majority
# Example Local format: mongodb://127.0.0.1:27017/backendDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/backend_assignment?retryWrites=true&w=majority
